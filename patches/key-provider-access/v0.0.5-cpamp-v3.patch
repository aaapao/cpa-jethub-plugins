+func TestSchedulerPrefersHighestPriorityTierOfEligibleProfiles(t *testing.T) {
+	installTestPolicy(t, policyDocument{Version: 2, Policies: []policyConfig{{
+		CallerScope:   scopeA,
+		AllowProfiles: []string{"*"},
+	}}})
+	request := schedulerPickRequest{
+		Provider: "mixed",
+		Model:    "shared-model",
+		Options:  schedulerOptions{Metadata: map[string]any{"caller_scope": scopeA}},
+		Candidates: []schedulerAuthCandidate{
+			{ID: "low-tier-a", Provider: "low", Priority: 4},
+			{ID: "top-tier-a", Provider: "top", Priority: 6},
+			{ID: "mid-tier-a", Provider: "mid", Priority: 5},
+			{ID: "top-tier-b", Provider: "top", Priority: 6},
+		},
+	}
+	want := []string{"top-tier-a", "top-tier-b", "top-tier-a", "top-tier-b"}
+	for index, expected := range want {
+		rawRequest, _ := json.Marshal(request)
+		rawResponse, err := pickProfile(rawRequest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var response schedulerPickResponse
+		unwrapEnvelope(t, rawResponse, &response)
+		if !response.Handled || response.AuthID != expected {
+			t.Fatalf("pick %d = %#v, want auth %q", index, response, expected)
+		}
+	}
+}
+
+func TestSchedulerReachesLowerTierWhenHigherTiersAreDenied(t *testing.T) {
+	installTestPolicy(t, policyDocument{Version: 2, Policies: []policyConfig{{
+		CallerScope:   scopeA,
+		AllowProfiles: []string{"only-allowed"},
+		DenyProfiles:  []string{"oauth-*"},
+	}}})
+	request := schedulerPickRequest{
+		Provider: "mixed",
+		Model:    "shared-model",
+		Options:  schedulerOptions{Metadata: map[string]any{"caller_scope": scopeA}},
+		Candidates: []schedulerAuthCandidate{
+			{ID: "oauth-a", Provider: "oauth", Priority: 6},
+			{ID: "oauth-b", Provider: "oauth", Priority: 5},
+			{ID: "only-allowed", Provider: "apikey", Priority: 4},
+		},
+	}
+	for index := 0; index < 3; index++ {
+		rawRequest, _ := json.Marshal(request)
+		rawResponse, err := pickProfile(rawRequest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var response schedulerPickResponse
+		unwrapEnvelope(t, rawResponse, &response)
+		if !response.Handled || response.AuthID != "only-allowed" {
+			t.Fatalf("pick %d = %#v, want the tier-4 allowed profile", index, response)
+		}
+	}
+}
+
+func TestHighestPriorityTierKeepsOrderAndHandlesEmptyInput(t *testing.T) {
+	if tier := highestPriorityTier(nil); len(tier) != 0 {
+		t.Fatalf("highestPriorityTier(nil) = %#v", tier)
+	}
+	candidates := []schedulerAuthCandidate{
+		{ID: "a", Priority: 3},
+		{ID: "b", Priority: 5},
+		{ID: "c", Priority: 5},
+	}
+	tier := highestPriorityTier(candidates)
+	if len(tier) != 2 || tier[0].ID != "b" || tier[1].ID != "c" {
+		t.Fatalf("highestPriorityTier() = %#v", tier)
+	}
+	if candidates[0].ID != "a" || len(candidates) != 3 {
+		t.Fatalf("highestPriorityTier mutated its input: %#v", candidates)
+	}
+}
