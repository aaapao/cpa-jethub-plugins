+// nextProfile picks the credential for a policy-approved request.
+//
+// The host delivers candidates from every priority tier (this plugin declares
+// scheduler_across_priorities), so the tier rule the host would otherwise apply is
+// reproduced here: only the highest priority tier present among the *eligible*
+// candidates takes part, and selection round-robins inside that tier. Narrowing after
+// the policy filter — instead of before it — is what lets a key reach a lower-priority
+// channel when every higher-priority channel is denied for that key.
 func (s *state) nextProfile(scope, provider, model string, candidates []schedulerAuthCandidate) string {
-	if len(candidates) == 0 {
+	tier := highestPriorityTier(candidates)
+	if len(tier) == 0 {
 		return ""
 	}
 	key := scope + "\x00" + strings.ToLower(strings.TrimSpace(provider)) + "\x00" + strings.TrimSpace(model)
@@ -499,7 +508,28 @@ func (s *state) nextProfile(scope, provider, model string, candidates []schedule
 	}
 	cursor := s.pickCursor[key]
 	s.pickCursor[key] = cursor + 1
-	return candidates[cursor%uint64(len(candidates))].ID
+	return tier[cursor%uint64(len(tier))].ID
+}
+
+// highestPriorityTier returns the candidates of the best priority tier in their
+// original order, so round-robin state stays stable across calls.
+func highestPriorityTier(candidates []schedulerAuthCandidate) []schedulerAuthCandidate {
+	if len(candidates) == 0 {
+		return nil
+	}
+	best := candidates[0].Priority
+	for _, candidate := range candidates[1:] {
+		if candidate.Priority > best {
+			best = candidate.Priority
+		}
+	}
+	tier := make([]schedulerAuthCandidate, 0, len(candidates))
+	for _, candidate := range candidates {
+		if candidate.Priority == best {
+			tier = append(tier, candidate)
+		}
+	}
+	return tier
 }
 
